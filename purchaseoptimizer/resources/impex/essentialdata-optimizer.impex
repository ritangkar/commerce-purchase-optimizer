# Essential data for the purchase optimizer. Safe for production: roles, rights, default tuning, lifecycle job.
# Import manually (or hook into your project's essential-data import). No sample/demo data here.

# ---------------------------------------------------------------- roles and type permissions
# campaignmanager     : maker - creates/edits campaigns, priorities and bundles (cannot approve)
# campaignapprover    : checker - may move items to APPROVED (a creator can never approve their own campaign)
# optimizerconfigadmin: edits OptimizerConfig and DealerSegment
# optimizerauditor    : read-only incl. the audit trail
# Add these groups to your Backoffice role(s) so the members can open Backoffice.
$START_USERRIGHTS;;;;;;;;;
Type;UID;MemberOfGroups;Password;Target;read;change;create;remove;change_perm
UserGroup;campaignmanager;employeegroup;;;;;;;
;;;;RecoCampaign;+;+;+;-;-
;;;;StrategicPriority;+;+;+;-;-
;;;;RecoBundle;+;+;+;-;-
;;;;RecoBundleEntry;+;+;+;+;-
;;;;DealerSegment;+;-;-;-;-
;;;;OptimizerConfig;+;-;-;-;-
UserGroup;campaignapprover;employeegroup;;;;;;;
;;;;RecoCampaign;+;+;-;-;-
;;;;StrategicPriority;+;+;-;-;-
;;;;RecoBundle;+;+;-;-;-
;;;;RecoBundleEntry;+;-;-;-;-
;;;;DealerSegment;+;-;-;-;-
;;;;OptimizerConfig;+;-;-;-;-
UserGroup;optimizerconfigadmin;employeegroup;;;;;;;
;;;;OptimizerConfig;+;+;+;+;-
;;;;DealerSegment;+;+;+;+;-
UserGroup;optimizerauditor;employeegroup;;;;;;;
;;;;OptimizerSuggestionAudit;+;-;-;-;-
;;;;RecoCampaign;+;-;-;-;-
;;;;StrategicPriority;+;-;-;-;-
;;;;RecoBundle;+;-;-;-;-
;;;;RecoBundleEntry;+;-;-;-;-
;;;;DealerSegment;+;-;-;-;-
;;;;OptimizerConfig;+;-;-;-;-
$END_USERRIGHTS;;;;;;;;;

# ---------------------------------------------------------------- default tuning (editable in Backoffice afterwards)
INSERT_UPDATE OptimizerConfig;code[unique=true];version;active;boostCap;strategicLineShareCap;strategicValueShareCap;gateMinCategoryOrders;minOrders;dueMin;dueMax
;DEFAULT;1;true;0.15;0.25;0.30;1;3;0.85;1.30

# ---------------------------------------------------------------- campaign lifecycle job (activate / expire by date)
INSERT_UPDATE ServicelayerJob;code[unique=true];springId[unique=true]
;campaignLifecycleJob;campaignLifecycleJob

INSERT_UPDATE CronJob;code[unique=true];job(code);singleExecutable;sessionLanguage(isocode)
;campaignLifecycleCronJob;campaignLifecycleJob;false;en

# every hour at minute 7
INSERT_UPDATE Trigger;cronJob(code)[unique=true];cronExpression
;campaignLifecycleCronJob;0 7 * * * ?
