<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- WsDTO extension: same property names as ProductData so the Orika DataMapper maps them by name. -->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="beans.xsd">

	<bean class="de.hybris.platform.commercewebservicescommons.dto.product.ProductWsDTO">
		<description>Fields added by the purchase optimizer</description>
		<property name="suggestedQuantity" type="java.lang.Long"/>
		<property name="suggestionReason" type="java.lang.String"/>
		<property name="confidenceTier" type="java.lang.String"/>
		<property name="suggestionGroup" type="java.lang.String"/>
		<property name="explanationSource" type="java.lang.String"/>
		<property name="evidenceLabels" type="java.util.List&lt;java.lang.String&gt;"/>
	</bean>

</beans>
