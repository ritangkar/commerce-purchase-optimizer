<?xml version="1.0" encoding="UTF-8"?>
<extensioninfo xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="extensioninfo.xsd">

	<extension abstractclassprefix="Birlaopusoptimizer"
	           classprefix="Birlaopusoptimizer"
	           name="birlaopusoptimizer">

		<requires-extension name="b2bcommerce"/>
		<requires-extension name="commercefacades"/>
		<requires-extension name="commercewebservicescommons"/>
		<requires-extension name="webservicescommons"/>

		<coremodule generated="true"
		            manager="com.birlaopus.optimizer.jalo.BirlaopusoptimizerManager"
		            packageroot="com.birlaopus.optimizer"/>

		<!-- Holds OptimizerController. See README for relocating it into an existing OCC web extension. -->
		<webmodule jspcompile="false" webroot="/birlaopusoptimizer"/>

	</extension>
</extensioninfo>
