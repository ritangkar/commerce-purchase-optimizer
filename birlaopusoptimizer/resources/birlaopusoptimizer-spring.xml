<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

	<!-- @Resource injection -->
	<context:annotation-config/>

	<bean id="optimizerOrderHistoryDao" class="com.birlaopus.optimizer.dao.impl.DefaultOptimizerOrderHistoryDao"/>

	<bean id="optimizerAiResponseValidator" class="com.birlaopus.optimizer.service.ai.AiResponseValidator"/>

	<bean id="optimizerOpenAiClient" class="com.birlaopus.optimizer.service.ai.OpenAiClient"/>

	<bean id="optimizerService" class="com.birlaopus.optimizer.service.impl.DefaultOptimizerService"/>

	<bean id="optimizerFacade" class="com.birlaopus.optimizer.facade.impl.DefaultOptimizerFacade"/>

</beans>
